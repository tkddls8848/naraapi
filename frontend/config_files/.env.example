# 배포용 환경변수 템플릿. 이 파일을 .env.production 으로 복사한 뒤 값을 채워라.
# 실제 값은 절대 커밋하지 않는다 (.gitignore 가 .env.production 을 무시한다).
# docker-compose 의 naraapi 와 postgres 서비스가 env_file 로 이 경로의 .env.production 을 읽는다.
# 로컬 개발은 frontend/.env.local 에 같은 키를 넣어도 된다.

# --- PostgreSQL (docker-compose 의 postgres 서비스로 자체 호스팅) -------------
# POSTGRES_* 는 postgres 컨테이너가 읽고, DATABASE_URL 은 앱이 읽는다.
#
# 주의: POSTGRES_* 는 **데이터 볼륨이 빈 최초 기동에만** 반영된다.
# 이미 데이터가 있는 볼륨에서 값을 바꿔도 계정은 바뀌지 않는다(README 참고).

POSTGRES_USER=naraapi
POSTGRES_PASSWORD=
POSTGRES_DB=naraapi

# 앱이 읽는 연결 문자열. 호스트는 compose 서비스명 'postgres' 다.
# 위 POSTGRES_* 값과 일치해야 한다.
#   예) DATABASE_URL=postgres://naraapi:<POSTGRES_PASSWORD>@postgres:5432/naraapi
# 비밀번호에 @ : / ? # 가 들어가면 퍼센트 인코딩해야 한다(예: @ -> %40).
DATABASE_URL=

# 나라장터(공공데이터포털) 오픈API 인증키.
# 주의: 값만이 아니라 `key=value` 형태 문자열을 통째로 넣는다.
#   예) SERVICE_KEY=serviceKey=abcd%2Befg...
# lib/nara-api.js 가 이 문자열을 쿼리스트링 맨 앞에 원문 그대로 붙인다.
# 값만 떼어 재인코딩하면 이중 인코딩으로 API 호출이 깨진다.
SERVICE_KEY=

# JWT 서명 키
TOKEN_SECRET_KEY=

# 로그인/회원 API 가 응답 body 의 state 값으로 그대로 내보내는 문자열들.
# 아래 4개는 프론트(app/login-panel.js, app/userlogin/join/page.js)가 문자열 그대로
# 비교하므로 이 값에서 바꾸면 로그인/가입 분기가 깨진다.
STATUS_WRONG_PASSWORD=wrong password
STATUS_NO_REGITERED=not registered user
STATUS_JOIN=join user
STATUS_ALREADY_JOIN=already join user

# 아래 3개는 프론트가 값을 비교하지 않고 응답에 실어 보내기만 한다.
# 기존 운영 .env 의 값을 그대로 옮겨라 (임의로 정해도 동작에는 지장 없다).
STATUS_REGITERED=
STATUS_MODIFY=
STATUS_DELETE=
