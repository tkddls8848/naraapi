# 배포 시 이 파일을 .env.production으로 복사하고 실제 값을 채우세요.
# .env.production은 커밋하지 않습니다. 로컬 Next.js 개발은 frontend/.env.local을 사용합니다.
# docker-compose.yml의 postgres와 naraapi 서비스가 같은 .env.production을 읽습니다.

# PostgreSQL 컨테이너 초기화 값입니다. 기존 postgres-data 볼륨에는 변경값이 적용되지 않습니다.
POSTGRES_USER=naraapi
POSTGRES_PASSWORD=
POSTGRES_DB=naraapi

# 애플리케이션과 Mongo 이관 스크립트가 사용하는 PostgreSQL 연결 문자열입니다.
# Compose 내부 예: postgres://naraapi:<password>@postgres:5432/naraapi
# 예약 문자가 포함된 비밀번호는 URL 인코딩하세요(예: @ -> %40).
DATABASE_URL=

# 공공데이터포털 서비스 키를 key=value 전체 형태로 입력합니다.
# 예: SERVICE_KEY=serviceKey=abcd%2Befg...
SERVICE_KEY=

# 기존 로그인 JWT를 서명하는 비밀 키입니다.
TOKEN_SECRET_KEY=
